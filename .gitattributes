*.png binary
*.gif binary
readme_assets/ export-ignore
LICENSE export-ignore

# Force LF for shell/perl/python scripts so they run on Linux/macOS CI even if
# edited on Windows. Mbed TLS codegen invokes these at build time.
*.sh   text eol=lf
*.pl   text eol=lf
*.py   text eol=lf

# The Linux package launcher has no extension, so the rules above miss it. CRLF here makes the
# installed .deb/.rpm fail to start with "bad interpreter: /bin/bash^M".
packaging/linux/launcher text eol=lf
