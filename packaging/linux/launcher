#!/bin/bash

# Advancely seeds and maintains its own user data directory (~/.local/share/advancely) on startup:
# see seed_user_data_dir() in source/main.cpp. It copies the shipped resources out of the installed
# resources directory on first run and after every version change, so this script no longer has to
# mirror that directory list. Keeping the list in one place means packages that ship or patch their
# own launcher (AUR, NixOS) stay correct without tracking changes to it.
#
# NOTE FOR PACKAGERS: the NixOS derivation rewrites the install prefix on the line below using
# substituteInPlace with --replace-fail, which fails the build outright if the prefix it searches
# for is absent. Keep that path spelled out literally below rather than moving it into a variable.

/usr/share/advancely/Advancely --disable-updater --use-home-dir "$@"
